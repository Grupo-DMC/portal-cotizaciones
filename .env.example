# Copia este archivo a .env.local (desarrollo) o configúralo en el entorno del servidor (producción).
# NUNCA subas el archivo con valores reales al repositorio.

# Firma de la cookie de sesión. OBLIGATORIO en producción (mínimo 32 caracteres aleatorios).
# Generar:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# "mock" = datos ficticios en memoria (por defecto). "mssql" = SQL Server (requiere implementar repositorios, ver docs/MIGRACION_MSSQL.md).
# Con "mssql" se oculta la caja de credenciales de demostración del login.
DATA_SOURCE=mock

# Conexión SQL Server (solo cuando DATA_SOURCE=mssql)
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=true
# Solo true en desarrollo con certificados autofirmados.
DB_TRUST_CERT=false
